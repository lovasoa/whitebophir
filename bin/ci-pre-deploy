#!/bin/sh
set -eu

release_version=$(sed -nE 's/^  "version": "([0-9]+\.[0-9]+\.[0-9]+)",$/\1/p' package.json)
test "$GITHUB_REF_NAME" = "v$release_version"

# Use the existing deployment credentials and mounted configuration.
# Dokku's one-off runner does not forward stdin. A data URL preserves the
# script as one shell argument without interpolating its JavaScript source.
script=$(base64 < .github/stamp-head-version.mjs | tr -d '\n')
ssh "$SSH_REMOTE" -- "run --no-tty $APP_NAME node --input-type=module -e 'await import(\"data:text/javascript;base64,$script\")' -- - $release_version"
