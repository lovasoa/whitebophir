#!/bin/sh
set -eu

if [ "${GITHUB_REPOSITORY:-}" != "lovasoa/whitebophir" ]; then
  echo "Refusing to release outside lovasoa/whitebophir." >&2
  exit 1
fi

# Never publish an older successful CI run over newer master changes.
tested_commit=$1
git fetch origin master --tags
if [ "$(git rev-parse origin/master)" != "$tested_commit" ]; then
  echo "Skipping release: master has moved since this CI run."
  exit 0
fi
test "$(git rev-parse HEAD)" = "$tested_commit"

npm version patch --no-git-tag-version --ignore-scripts
release_tag=v$(node -p 'require("./package.json").version')
git add package.json package-lock.json
git -c core.hooksPath=/dev/null commit -m "Release $release_tag"
release_commit=$(git rev-parse HEAD)

# Keep generated assets in the distribution tag, outside the source branch.
archive=$(mktemp)
trap 'rm -f "$archive"' EXIT
cutoff=$(( $(date +%s) - 7 * 24 * 60 * 60 ))
recent_tags=$(git for-each-ref --format='%(creatordate:unix) %(refname:short)' 'refs/tags/v*' |
  awk -v cutoff="$cutoff" '$1 >= cutoff && $2 ~ /^v[0-9]+\.[0-9]+\.[0-9]+$/ {print $2}')
for tag in $recent_tags; do
  if ! git merge-base --is-ancestor "$tag^" "$tested_commit"; then
    continue
  fi
  destination="client-data/assets/${tag#v}"
  mkdir -p "$destination"
  git archive --format=tar --output="$archive" "$tag:client-data" -- . ':!assets'
  tar -xf "$archive" -C "$destination"
done
if [ -d client-data/assets ]; then
  git add client-data/assets
  git -c core.hooksPath=/dev/null commit -m "Include recent client assets in $release_tag"
fi

git tag "$release_tag"
# A concurrent master update rejects the entire push, including the tag.
git push --atomic origin "$release_commit:refs/heads/master" "refs/tags/$release_tag"
echo "tag=$release_tag" >> "$GITHUB_OUTPUT"
