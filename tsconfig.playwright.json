{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "types/**/*.d.ts",
    "playwright/**/*.ts",
    "playwright/**/*.d.ts",
    "playwright.config.ts"
  ]
}
